GEMINI_API_KEY=your_gemini_api_key_here
MONGO_URI=your_mongodb_atlas_connection_string_here

# -- Chroma Configuration --
# Set CHROMA_ENV to 'cloud' for production, or 'local' for development
CHROMA_ENV=local

# Local Development Settings (defaults to localhost:8000)
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Chroma Cloud Settings (required when CHROMA_ENV=cloud)
CHROMA_CLOUD_TENANT=default_tenant
CHROMA_CLOUD_DATABASE=NexaDB
CHROMA_CLOUD_API_KEY=your_chroma_api_key_here

# -- CORS Configuration --
# Comma-separated list of allowed origins. Omit or leave empty for permissive (development).
# Example: https://your-frontend.vercel.app,https://your-other-domain.com
# CORS_ORIGIN=
